# headless smoke: drives a full blit frame without a GL backend, hosting the
# library's tests under a bin artifact (a static lib carries no _start, so the
# tests must be built and run through a bin). exercises the public surface end to
# end and prints the resulting vertex count.

use std.runtime;
use std.types.size.usize;
use std.types.string.str;
use std.types.option.Option;
use print: std.print;
use allo:  std.allocator;
use page:  std.allocator.page;

use blit;

$main.symbol = "main";
fun main(argc: i64, argv: **u8) i64 {
    var a: allo.Allocator;
    page.make(?a);

    val ae: Option[str] = blit.font.build_atlas(?a);
    if (ae.has_value) { print.println("atlas build failed"); ret 1; }

    var ctx: blit.context.Context;
    if (blit.context.init(?ctx, ?a).has_value) { print.println("context init failed"); ret 1; }

    var checked: u8 = 1;
    var amount:  f32 = 0.5::f32;

    var in: blit.input.Input;
    in.mx = 20.0::f32; in.my = 30.0::f32; in.down = 0; in.prev_down = 0;

    blit.context.begin(?ctx, in, 800.0::f32, 600.0::f32);
    val panel: usize = blit.widget.begin_panel(?ctx, 8.0::f32, 8.0::f32, 200.0::f32);
    blit.widget.text(?ctx, "blit headless smoke");
    blit.widget.button(?ctx, "step");
    blit.widget.checkbox(?ctx, "running", ?checked);
    blit.widget.slider_f(?ctx, "rate", ?amount, 0.0::f32, 1.0::f32);
    blit.widget.end_panel(?ctx, panel);
    blit.context.end(?ctx);

    print.printf("blit %s: %d vertices, ok=%d\n",
                 blit.VERSION,
                 blit.context.draw_count(?ctx)::i64,
                 blit.context.ok(?ctx)::i64);

    blit.context.free(?ctx);
    ret 0;
}
